{
  "name": "salice-inteligente",
  "private": true,
  "version": "1.5.1",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,blue \"pnpm run dev:api\" \"pnpm run dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "profile:gesi": "tsx scripts/profile-gesi.ts",
    "capture:gesi": "tsx scripts/capture-gesi.ts",
    "audit:gesi-capture": "tsx scripts/audit-gesi-capture.ts",
    "audit:client-status": "tsx scripts/audit-client-status.ts --live",
    "sync:gesi": "tsx scripts/sync-gesi.ts",
    "refresh:gesi": "tsx scripts/refresh-gesi-manual.ts",
    "refresh:gesi:resume": "tsx scripts/refresh-gesi-manual.ts --resume",
    "enrich:ai": "tsx scripts/enrich-ai.ts",
    "enrich:ai:resume": "tsx scripts/enrich-ai.ts --resume",
    "evaluate:ai-effort": "tsx scripts/evaluate-commercial-ai-effort.ts",
    "adopt:data-bundle": "tsx scripts/adopt-data-bundle.ts",
    "audit:data": "tsx scripts/audit-data.ts",
    "audit:platform": "tsx scripts/audit-platform.ts",
    "audit:vectors": "tsx scripts/audit-product-vectors.ts",
    "backfill:prices": "tsx scripts/backfill-product-price-history.ts",
    "audit:prices": "tsx scripts/audit-product-prices.ts",
    "compare:vectors": "tsx scripts/compare-product-vector-versions.ts",
    "audit:operations": "tsx scripts/audit-operations.ts",
    "backup:operations": "tsx scripts/backup-operations.ts",
    "restore:operations": "tsx scripts/restore-operations.ts",
    "build:spt-gesi": "tsx scripts/build-spt-gesi.ts",
    "build:pending-balances": "tsx scripts/build-pending-balances.ts",
    "backfill:spt-gesi": "NODE_OPTIONS=--max-old-space-size=6144 tsx scripts/backfill-spt-gesi.ts",
    "audit:spt-gesi": "tsx scripts/audit-spt-gesi.ts",
    "reconcile:spt": "tsx scripts/reconcile-spt-sources.ts",
    "import:spt-pbix": "python3 scripts/import-spt-pbix.py",
    "test": "vitest run --maxWorkers 2 --testTimeout 30000",
    "test:reconciliation": "vitest run server/historical-report-reconciliation.test.ts"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.525.0",
    "nodemailer": "^9.0.3",
    "openai": "^6.49.0",
    "pdfkit": "^0.19.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-leaflet": "^5.0.0",
    "stream-chain": "4.2.5",
    "stream-json": "3.5.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^24.0.13",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^3.2.4"
  }
}
