{
  "name": "salice-inteligente",
  "private": true,
  "version": "0.0.4",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,blue \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "profile:gesi": "tsx scripts/profile-gesi.ts",
    "capture:gesi": "tsx scripts/capture-gesi.ts",
    "audit:gesi-capture": "tsx scripts/audit-gesi-capture.ts",
    "audit:client-status": "tsx scripts/audit-client-status.ts --live",
    "sync:gesi": "tsx scripts/sync-gesi.ts",
    "refresh:gesi": "npm run capture:gesi && npm run audit:gesi-capture && npm run sync:gesi && npm run audit:data",
    "audit:data": "tsx scripts/audit-data.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.525.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^24.0.13",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^3.2.4"
  }
}
