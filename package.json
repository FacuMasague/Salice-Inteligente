{
  "name": "smart-salice",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,blue \"pnpm run dev:api\" \"pnpm run dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "prepare:demo": "tsx scripts/prepare-demo.ts",
    "audit:data": "tsx scripts/audit-data.ts",
    "audit:platform": "tsx scripts/audit-platform.ts",
    "audit:vectors": "tsx scripts/audit-product-vectors.ts",
    "audit:operations": "tsx scripts/audit-operations.ts",
    "backup:operations": "tsx scripts/backup-operations.ts",
    "restore:operations": "tsx scripts/restore-operations.ts",
    "audit:commercial-data": "tsx scripts/audit-commercial-data.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.525.0",
    "pdfkit": "^0.19.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^24.0.13",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^3.2.4"
  }
}
